@startuml panel-context
title Bounded Context: Panel

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "domain.ports" {
  enum PanelPaymentStatus {
    PENDING
    PARTIAL
    PAID
  }

  class PanelBookingSummary {
    +id: number
    +startTime: Date
    +endTime: Date
    +totalAmount: number
    +paidAmount: number
    +paymentStatus: PanelPaymentStatus
    +court: {id, name}
    +customer: {id, name}?
  }

  interface PanelRepository {
    +getBookingsForDate(date): Promise<PanelBookingSummary[]>
    +getPaidTotalForDate(date): Promise<number>
    +getPendingPaymentsForDate(date): Promise<PanelBookingSummary[]>
  }

  PanelRepository ..> PanelBookingSummary
  note top of PanelBookingSummary
    No es un aggregate propio:
    proyeccion de solo lectura
    sobre datos de Bookings/Payments
    para el dashboard del dia.
  end note
}

package "infrastructure.persistence" {
  class PrismaPanelRepository {
    +getBookingsForDate(date)
    +getPaidTotalForDate(date)
    +getPendingPaymentsForDate(date)
  }

  PrismaPanelRepository ..|> PanelRepository
}

package "application (casos de uso)" {
  class getBookingsToday << (F,orchid) factory >>
  class getIncomeToday << (F,orchid) factory >>
  class getPendingPaymentsToday << (F,orchid) factory >>

  getBookingsToday ..> PanelRepository
  getIncomeToday ..> PanelRepository
  getIncomeToday ..> getBookingsToday
  getPendingPaymentsToday ..> PanelRepository
  getPendingPaymentsToday ..> getBookingsToday
}

@enduml
