// Prisma schema — La Canchita de Carlos backend

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION

  @@map("user_status_enum")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("request_status_enum")
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE

  @@map("court_status_enum")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status_enum")
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED

  @@map("booking_status_enum")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID

  @@map("payment_status_enum")
}

enum BookingType {
  SINGLE
  MULTIDAY
  RECURRING

  @@map("booking_type_enum")
}

enum SeriesPaymentMode {
  INDIVIDUAL
  LUMP_SUM

  @@map("series_payment_mode_enum")
}

enum NotificationType {
  ACCESS_REQUEST
  PAYMENT_PENDING
  NEW_BOOKING
  BOOKING_CANCELLED
  COURT_MAINTENANCE
  GENERAL

  @@map("notification_type_enum")
}

model User {
  id           Int        @id @default(autoincrement()) @map("usu_id")
  name         String     @map("usu_name") @db.VarChar(150)
  username     String     @unique @map("usu_username") @db.VarChar(60)
  email        String     @unique @map("usu_email") @db.VarChar(150)
  passwordHash String     @map("usu_password_hash") @db.VarChar(255)
  isOwner      Boolean    @default(false) @map("usu_is_owner")
  status       UserStatus @default(ACTIVE) @map("usu_status")
  photoUrl     String?    @map("usu_photo_url")
  lastAccess   DateTime?  @map("usu_last_access") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("usu_created_at") @db.Timestamptz()
  updatedAt    DateTime   @default(now()) @updatedAt @map("usu_updated_at") @db.Timestamptz()

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  accessRequestsCreated   AccessRequest[]
  notifications           Notification[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement()) @map("ses_id")
  userId    Int      @map("ses_user_id")
  tokenHash String   @unique @map("ses_token_hash") @db.VarChar(255)
  ipAddress String?  @map("ses_ip_address") @db.VarChar(45)
  userAgent String?  @map("ses_user_agent")
  createdAt DateTime @default(now()) @map("ses_created_at") @db.Timestamptz()
  expiresAt DateTime @map("ses_expires_at") @db.Timestamptz()
  revoked   Boolean  @default(false) @map("ses_revoked")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement()) @map("prt_id")
  userId    Int      @map("prt_user_id")
  tokenHash String   @unique @map("prt_token_hash") @db.VarChar(255)
  expiresAt DateTime @map("prt_expires_at") @db.Timestamptz()
  used      Boolean  @default(false) @map("prt_used")
  createdAt DateTime @default(now()) @map("prt_created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement()) @map("evt_id")
  userId    Int      @map("evt_user_id")
  tokenHash String   @unique @map("evt_token_hash") @db.VarChar(255)
  expiresAt DateTime @map("evt_expires_at") @db.Timestamptz()
  used      Boolean  @default(false) @map("evt_used")
  createdAt DateTime @default(now()) @map("evt_created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("email_verification_tokens")
}

model AccessRequest {
  id            Int           @id @default(autoincrement()) @map("req_id")
  name          String        @map("req_name") @db.VarChar(150)
  email         String        @map("req_email") @db.VarChar(150)
  phone         String?       @map("req_phone") @db.VarChar(30)
  passwordHash  String        @map("req_password_hash") @db.VarChar(255)
  status        RequestStatus @default(PENDING) @map("req_status")
  createdUserId Int?          @map("req_created_user_id")
  createdAt     DateTime      @default(now()) @map("req_created_at") @db.Timestamptz()
  resolvedAt    DateTime?     @map("req_resolved_at") @db.Timestamptz()

  createdUser User? @relation(fields: [createdUserId], references: [id])

  @@map("access_requests")
}

model Court {
  id           Int         @id @default(autoincrement()) @map("cou_id")
  name         String      @map("cou_name") @db.VarChar(100)
  sport        String      @map("cou_sport") @db.VarChar(50)
  surface      String?     @map("cou_surface") @db.VarChar(80)
  pricePerHour Decimal     @map("cou_price_per_hour") @db.Decimal(10, 2)
  status       CourtStatus @default(ACTIVE) @map("cou_status")
  enabled      Boolean     @default(true) @map("cou_enabled")
  photoUrl     String?     @map("cou_photo_url")
  description  String?     @map("cou_description")
  openTime     String?     @map("cou_open_time") @db.VarChar(5)
  closeTime    String?     @map("cou_close_time") @db.VarChar(5)
  createdAt    DateTime    @default(now()) @map("cou_created_at") @db.Timestamptz()
  updatedAt    DateTime    @default(now()) @updatedAt @map("cou_updated_at") @db.Timestamptz()

  scheduleBlocks ScheduleBlock[]
  bookings       Booking[]

  @@map("courts")
}

model ScheduleBlock {
  id        Int      @id @default(autoincrement()) @map("blo_id")
  courtId   Int      @map("blo_court_id")
  date      DateTime @map("blo_date") @db.Date
  time      DateTime @map("blo_time") @db.Time()
  reason    String?  @map("blo_reason") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("blo_created_at") @db.Timestamptz()

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("schedule_blocks")
}

model Customer {
  id             Int            @id @default(autoincrement()) @map("cus_id")
  name           String         @map("cus_name") @db.VarChar(150)
  phone          String         @map("cus_phone") @db.VarChar(30)
  documentNumber String?        @unique @map("cus_document_number") @db.VarChar(20)
  status         CustomerStatus @default(ACTIVE) @map("cus_status")
  createdAt      DateTime       @default(now()) @map("cus_created_at") @db.Timestamptz()
  updatedAt      DateTime       @default(now()) @updatedAt @map("cus_updated_at") @db.Timestamptz()

  bookings Booking[]

  @@map("customers")
}

model Payment {
  id        Int      @id @default(autoincrement()) @map("pay_id")
  bookingId Int      @map("pay_booking_id")
  amount    Decimal  @map("pay_amount") @db.Decimal(10, 2)
  method    String   @map("pay_method") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("pay_created_at") @db.Timestamptz()

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Booking {
  id                Int                @id @default(autoincrement()) @map("boo_id")
  courtId           Int                @map("boo_court_id")
  customerId        Int?               @map("boo_customer_id")
  customerName      String             @map("boo_customer_name") @db.VarChar(150)
  type              String?            @map("boo_type") @db.VarChar(80)
  date              DateTime           @map("boo_date") @db.Date
  startTime         DateTime           @map("boo_start_time") @db.Time()
  endTime           DateTime           @map("boo_end_time") @db.Time()
  status            BookingStatus      @default(BOOKED) @map("boo_status")
  paymentStatus     PaymentStatus      @default(PENDING) @map("boo_payment_status")
  totalAmount       Decimal            @default(0) @map("boo_total_amount") @db.Decimal(10, 2)
  paidAmount        Decimal            @default(0) @map("boo_paid_amount") @db.Decimal(10, 2)
  bookingType       BookingType        @default(SINGLE) @map("boo_booking_type")
  seriesId          String?            @map("boo_series_id") @db.Uuid
  seriesPaymentMode SeriesPaymentMode? @map("boo_series_payment_mode")
  seriesLabel       String?            @map("boo_series_label") @db.VarChar(200)
  seriesTotalDates  Int?               @map("boo_series_total_dates")
  seriesIndex       Int?               @map("boo_series_index")
  receiptUrl        String?            @map("boo_receipt_url")
  createdAt         DateTime           @default(now()) @map("boo_created_at") @db.Timestamptz()
  updatedAt         DateTime           @default(now()) @updatedAt @map("boo_updated_at") @db.Timestamptz()

  court    Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@map("bookings")
}

model Notification {
  id        Int              @id @default(autoincrement()) @map("ntf_id")
  userId    Int?             @map("ntf_user_id")
  type      NotificationType @default(GENERAL) @map("ntf_type")
  title     String           @map("ntf_title") @db.VarChar(150)
  message   String?          @map("ntf_message")
  linkUrl   String?          @map("ntf_link_url") @db.VarChar(200)
  read      Boolean          @default(false) @map("ntf_read")
  createdAt DateTime         @default(now()) @map("ntf_created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}
